# --- Django ---
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Database (PostGIS) ---
DB_NAME=smartfleet
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Eskiz SMS (mock rejim) ---
ESKIZ_MOCK=True
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
OTP_EXPIRE_SECONDS=120

# --- Yandex Maps (real) ---
YANDEX_MAPS_API_KEY=

# --- OSRM (real, public server) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- Click to'lov (real) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- Email (og'ir texnika operatorga) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
OPERATOR_EMAIL=operator@smartfleet.uz
DEFAULT_FROM_EMAIL=noreply@smartfleet.uz

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True

# --- To'y transporti narxi (so'm/soat) ---
# Ilgari kodda hardcoded edi, endi shu yerdan sozlanadi
WEDDING_HOURLY_RATE=125000

# --- Og'ir texnika kunlik narxlari (so'm) ---
HEAVY_RATE_EARTH=1800000
HEAVY_RATE_LIFTING=2500000
HEAVY_RATE_TRANSPORT=1200000
HEAVY_RATE_SPECIAL=3000000
HEAVY_RATE_DEFAULT=1500000

# --- Buyurtma e'loni radiusi (metr) ---
ORDER_BROADCAST_RADIUS_M=15000

# --- Geocoding ---
YANDEX_MAPS_API_KEY=
GEOCODE_CACHE_SECONDS=86400
THROTTLE_GEOCODE=60/min
