# Backend server manzili. Bu qatorni ".env" nomli faylga nusxalab,
# haqiqiy qiymatni kiriting (".env" fayli git'ga qo'shilmaydi).
#
# Sozlanmasa — kod ichidagi standart production manzili ishlatiladi:
#   https://backend.smart-fleet.uz   (src/api/config.ts)
#
# Lokal backend bilan ishlash uchun kompyuteringiz LAN IP'sini yozing
# (`ipconfig` — "IPv4-адрес" qatori):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=https://backend.smart-fleet.uz
