# Backend server manzili. Bu qatorni ".env" nomli faylga nusxalab,
# haqiqiy qiymatni kiriting (".env" fayli git'ga qo'shilmaydi).
#
# Lokal rivojlantirish uchun shart emas — sozlanmasa, kod ichidagi
# standart LAN IP ishlatiladi (src/api/config.ts).
#
# Productionda (serverga qo'yilganda) domenni shu yerga yozing:
# EXPO_PUBLIC_API_URL=https://api.smartfleet.uz
EXPO_PUBLIC_API_URL=
